{
  "base_model": "checkpoints/base/SmolLM2-135M-Instruct",
  "output_dir": "checkpoints/adapters/smollm2-135m-lora",
  "log_csv": "results/logs/train_135m.csv",
  "seed": 42,
  "threads": 4,
  "max_len": 1024,
  "lora_r": 16,
  "lora_alpha": 32,
  "lora_dropout": 0.05,
  "target_modules": ["q_proj", "k_proj", "v_proj", "o_proj", "gate_proj", "up_proj", "down_proj"],
  "lr": 0.0003,
  "weight_decay": 0.01,
  "warmup_ratio": 0.1,
  "max_grad_norm": 1.0,
  "epochs": 3,
  "batch_size": 4,
  "grad_accum": 4
}

