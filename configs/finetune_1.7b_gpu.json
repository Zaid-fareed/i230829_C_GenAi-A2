{
  "base_model": "checkpoints/base/SmolLM2-1.7B-Instruct",
  "output_dir": "checkpoints/adapters/smollm2-1.7b-lora",
  "log_csv": "results/logs/train_1.7b_gpu.csv",
  "seed": 42,
  "threads": 4,
  "max_len": 1024,
  "lora_r": 16,
  "lora_alpha": 32,
  "lora_dropout": 0.05,
  "target_modules": [
    "q_proj",
    "k_proj",
    "v_proj",
    "o_proj",
    "gate_proj",
    "up_proj",
    "down_proj"
  ],
  "lr": 0.0002,
  "weight_decay": 0.01,
  "warmup_ratio": 0.1,
  "max_grad_norm": 1.0,
  "epochs": 3,
  "batch_size": 1,
  "grad_accum": 16,
  "amp": "fp16"
}